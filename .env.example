# Copiar a .env en la raiz. No versionar el archivo privado.
# Ver docs/operations/postgresql-credentials.md para generar y rotar credenciales.
POSTGRES_DB=humworld
POSTGRES_USER=humworld
POSTGRES_PASSWORD=
# URL con host postgres, misma base/usuario y password codificado para URL.
DATABASE_URL=
CAPTURE_SCHEDULER_ENABLED=true
