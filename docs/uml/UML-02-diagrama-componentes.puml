@startuml UML-02-diagrama-componentes
' Vista lógica por responsabilidades. Regenerar con:
'   plantuml -charset UTF-8 -tsvg docs/uml/UML-02-diagrama-componentes.puml
!pragma layout smetana
top to bottom direction
skinparam componentStyle uml2
skinparam defaultFontName Arial
skinparam shadowing false
skinparam nodesep 35
skinparam ranksep 45
skinparam packageStyle rectangle

title HumWorld — Componentes principales

package "Frontend · React" as FE {
  component "Consulta pública\nLanding y dashboard" as Public
  component "Administración" as Admin
}

package "Backend · FastAPI" as BE {
  component "API REST\n/api/v1" as API
  component "Control de acceso\nValidación de JWT" as Auth

  component "Servicios de aplicación" as Services {
    component "Consultas y agregación" as Queries
    component "Gestión de fuentes,\ncanales y diccionario" as Management
    component "Configuración" as Config
    component "Captura RSS" as Capture
    component "Análisis de sentimiento" as Sentiment
    component "Atribución geográfica" as Geography
    component "Purgado de noticias" as Purge
  }

  component "Planificador de tareas" as Scheduler
  component "Persistencia\nRepositorios · SQLAlchemy" as Data
}

component "Clerk" as Clerk <<externo>>
component "Cartografía · CDN" as Maps <<externo>>
component "Feeds RSS" as RSS <<externo>>
database "PostgreSQL" as DB

Public ..> API : JSON
Admin ..> API : JSON + Bearer
Admin ..> Clerk : sesión
Public ..> Maps : mapa del dashboard

API ..> Auth : operaciones administrativas
API ..> Services : casos de uso
Config ..> Scheduler : reprograma
Scheduler ..> Capture : ejecuta
Scheduler ..> Purge : ejecuta
Capture ..> RSS : HTTP / RSS
Capture ..> Sentiment
Capture ..> Geography
Purge ..> Config : caducidad
Services ..> Data : acceso a datos
Data ..> DB : SQL

@enduml
